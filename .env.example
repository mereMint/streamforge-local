# Network
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATA_DIR=./data
# Optional direct HTTPS. Both files must be present when either is set.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Generated by install.sh. Keep both values private.
DASHBOARD_TOKEN=replace-with-a-long-random-token
APP_SECRET=replace-with-64-random-hex-characters
# Optional separate token for Streamer.bot/Twitch event webhooks.
EVENT_WEBHOOK_TOKEN=

# Optional Discord bootstrap defaults. The normal setup path is the website's
# Discord page; website values are encrypted in the local database and override
# these fields.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_OWNER_USER_IDS=
DISCORD_AUTO_ROLE_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_TEMP_VOICE_LOBBY_ID=
DISCORD_TEMP_VOICE_CATEGORY_ID=
# Optional: the Discord voice channel used for PNGtuber speaking detection.
DISCORD_REACTIVE_VOICE_CHANNEL_ID=

# Optional Spotify now-playing integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify requires HTTPS except for its explicit 127.0.0.1/[::1] loopback
# exception. A normal LAN address such as http://192.168.x.x is not accepted.
# Example: https://streamforge.example.com/auth/spotify/callback
SPOTIFY_REDIRECT_URI=

# Optional Twitch chat bot bootstrap token. The normal setup path is the
# dashboard's Twitch Commands page, where the token is encrypted locally.
TWITCH_OAUTH_TOKEN=

# Optional rclone destination, for example: gdrive:StreamForge
RCLONE_REMOTE=

# Runtime tuning
STATUS_UPDATE_SECONDS=60
SPOTIFY_POLL_SECONDS=10
# Discord can only run saved service IDs; the dashboard owner may edit this
# allowlist. Set false if service definitions should only be changed over SSH.
SERVICE_EDIT_ENABLED=true
LOG_LEVEL=info
